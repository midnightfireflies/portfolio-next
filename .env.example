# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables Example for portfolio-next
# Copy this file to .env.local for local development. Never commit real secrets!
# ─────────────────────────────────────────────────────────────────────────────

# Optional: Email Delivery Provider (Resend)
# Obtain an API key from https://resend.com/
# If unset, the server endpoint validates inputs and falls back transparently to direct mailto client.
RESEND_API_KEY=

# Destination email for contact form notifications
CONTACT_NOTIFICATION_EMAIL=sadmansiam1110@gmail.com

# Optional: Next.js site URL for metadata / OpenGraph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
